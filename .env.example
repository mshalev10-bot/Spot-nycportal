# Live HubSpot read-only private app token.
# Leave this empty to run in demo mode (fake data, no HubSpot calls).
HUBSPOT_PRIVATE_APP_TOKEN=

# Signs the httpOnly session cookie. Required for live mode.
# Generate one with: openssl rand -base64 32
# Demo mode uses a built-in secret when this is unset. Do not use that in production.
SESSION_SECRET=

# true  = always serve fake data, even if a token is set
# false = require the token (the app errors instead of silently using demo data)
# unset = demo mode when HUBSPOT_PRIVATE_APP_TOKEN is empty, live mode when it is set
DEMO_MODE=

# Owner logins. JSON array of { "email", "name", "passwordHash" }.
# Create a hash with: npm run hash-password
# If this is unset, the app reads ./data/users.json when that file exists.
# If neither is set, demo mode enables the built-in accounts documented in the README.
# Live mode will not start until at least one account is configured.
# OWNER_USERS=[{"email":"owner@thespot-nyc.com","name":"Venue owner","passwordHash":"scrypt$..."}]

# Optional override for the users file. Defaults to ./data/users.json
# OWNER_USERS_FILE=

# In-memory cache lifetime in seconds. Clamped to 120–300. Default 180.
CACHE_TTL_SECONDS=180
